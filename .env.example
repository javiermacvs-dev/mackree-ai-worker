# Bearer secret shared with the Vercel app. Vercel sends this in
# Authorization: Bearer ${WORKER_SECRET} on every POST /render.
# Generate with: openssl rand -hex 32
WORKER_SECRET=

# Supabase: service role key (worker bypasses RLS to read/write storage).
SUPABASE_URL=https://pbfbgezarmcqxuctdrml.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where the worker calls back when a render finishes. The Vercel app
# verifies that the request comes from us via the same WORKER_SECRET.
CALLBACK_URL=https://mackree-ai.vercel.app/api/webhooks/render-complete

# Render workspace (tmpfs by default; Easypanel can mount a volume)
RENDER_WORKDIR=/tmp/render-jobs

# Bucket name in Supabase Storage. Worker reads media_*.{ext} + voice.mp3
# + job.json from <bucket>/<userId>/<jobId>/ and writes output.mp4 there.
STORAGE_BUCKET=video-jobs

PORT=8080
